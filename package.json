{
  "name": "themelios-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "build:packages": "bun scripts/build-packages.ts",
    "pack:packages": "bun scripts/pack-packages.ts",
    "build:portable": "bun scripts/build-portable.ts",
    "check:repo": "bun scripts/check/repo.ts",
    "docs:tasks": "bun scripts/docs-tasks.ts",
    "test:live": "bun tests/e2e/live-workbench.ts",
    "test:distribution": "bun tests/e2e/distribution.ts",
    "workbench": "bun --no-install apps/workbench/dist/main.js",
    "lint:agent": "oxlint --format=agent",
    "fallow:agent": "fallow --format json --quiet --lean"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "extensions/*"
    ],
    "catalog": {
      "zod": "4.6.7"
    }
  },
  "trustedDependencies": [],
  "devDependencies": {
    "@ast-grep/cli": "0.51.3",
    "@modelcontextprotocol/client": "2.4.0",
    "@themelios/application": "workspace:*",
    "@themelios/content": "workspace:*",
    "@themelios/core": "workspace:*",
    "@themelios/models": "workspace:*",
    "@themelios/pdf": "workspace:*",
    "@themelios/runtime": "workspace:*",
    "@themelios/storage": "workspace:*",
    "@themelios/transports": "workspace:*",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "fallow": "3.43.2",
    "fallow-type-aware": "3.43.2",
    "oxlint": "1.93.0",
    "pdf-lib": "1.17.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "zod": "catalog:"
  }
}
