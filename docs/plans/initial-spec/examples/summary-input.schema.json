{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "language": { "type": "string", "enum": ["zh-CN", "en"], "default": "zh-CN" },
    "maxSections": { "type": "integer", "minimum": 1, "maximum": 12, "default": 6 },
    "focus": { "anyOf": [{ "type": "string", "maxLength": 2000 }, { "type": "null" }], "default": null }
  },
  "additionalProperties": false
}
