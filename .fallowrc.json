{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["scripts/portable/launch.mjs"],
  "supportEntry": [
    "scripts/harness/run.mjs",
    "examples/embedded/embedded-summary.ts",
    "examples/inventory/install-release.ts",
    "examples/inventory/main.ts",
    "tests/integration/transports/stdio-host.ts",
    "tests/platform/runtime/held-instance.ts"
  ],
  "typeAware": {
    "enabled": true
  },
  "ignorePatterns": ["docs/plans/**"],
  "publicPackages": [
    "@themelios/application",
    "@themelios/content",
    "@themelios/core",
    "@themelios/models",
    "@themelios/pdf",
    "@themelios/runtime",
    "@themelios/storage",
    "@themelios/transports"
  ],
  "ignoreDependencies": ["@ast-grep/cli"],
  "cache": {
    "dir": "temp/cache/fallow"
  }
}
